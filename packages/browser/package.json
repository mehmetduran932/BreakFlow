{
  "name": "@breakflow/browser",
  "version": "0.1.2",
  "description": "Browser DOM layout measurement, sandbox cloning, DOM pagination, and debug overlay for BreakFlow.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@breakflow/core": "workspace:*"
  },
  "keywords": [
    "pagination",
    "browser",
    "dom",
    "print",
    "pdf"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetduran932/BreakFlow.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/mehmetduran932/BreakFlow/issues"
  },
  "homepage": "https://github.com/mehmetduran932/BreakFlow#readme",
  "author": "BreakFlow Contributors",
  "license": "MIT"
}
