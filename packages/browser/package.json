{
  "name": "@breakflow/browser",
  "version": "0.1.0",
  "description": "Browser DOM layout measurement, sandbox cloning, DOM pagination, and debug overlay for BreakFlow.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@breakflow/core": "workspace:*"
  },
  "keywords": [
    "pagination",
    "browser",
    "dom",
    "print",
    "pdf"
  ],
  "author": "BreakFlow Contributors",
  "license": "MIT"
}
